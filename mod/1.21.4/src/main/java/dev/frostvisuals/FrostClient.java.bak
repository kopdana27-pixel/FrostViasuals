package dev.frostvisuals;
import net.fabricmc.api.ClientModInitializer;
import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientTickEvents;
import net.fabricmc.fabric.api.client.keybinding.v1.KeyBindingHelper;
import net.minecraft.client.option.KeyBinding;
import net.minecraft.client.util.InputUtil;
import net.minecraft.text.Text;
import org.lwjgl.glfw.GLFW;
public final class FrostClient implements ClientModInitializer {
  private KeyBinding menu;
  @Override public void onInitializeClient() {
    menu = KeyBindingHelper.registerKeyBinding(new KeyBinding("key.frostvisuals.menu", InputUtil.Type.KEYSYM, GLFW.GLFW_KEY_RIGHT_SHIFT, "category.frostvisuals"));
    ClientTickEvents.END_CLIENT_TICK.register(client -> { while (menu.wasPressed()) if (client.player != null) client.player.sendMessage(Text.literal("Frost Visuals 3.0 — меню в разработке"), true); });
  }
}
