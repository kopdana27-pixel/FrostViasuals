const groups={
'Интерфейс':[['Module List','Список активных модулей с настройкой позиции'],['Keystrokes','Отображение WASD и нажатий клавиш'],['CPS Counter','Счётчик кликов мыши'],['Crosshair Editor','Форма, размер, цвет и прозрачность прицела'],['Chat Customizer','Настройка внешнего вида чата'],['Hotbar Style','Кастомизация панели быстрого доступа'],['Inventory Blur','Мягкое затемнение фона интерфейса'],['Notifications','Красивые уведомления и тосты'],['Scoreboard Style','Компактное оформление таблицы счёта'],['Bossbar Style','Настройка полос боссов'],['Tab List','Визуальное оформление списка игроков'],['Title Effects','Анимации заголовков'],['Menu Background','Фон главного меню']],
'HUD Visuals':[['FPS Counter','Текущий FPS и среднее значение'],['Ping Display','Задержка до игрового сервера'],['Coordinates','XYZ и направление взгляда'],['Armor HUD','Состояние экипировки'],['Potion HUD','Активные эффекты и время'],['Durability','Прочность предметов'],['Target Info','Информация о выбранной цели без скрытого обнаружения'],['Totem Counter','Количество тотемов в инвентаре'],['Food HUD','Уровень голода и насыщения'],['Clock','Время мира и реальное время'],['Speedometer','Скорость передвижения'],['Memory HUD','Использование памяти Java'],['Biome Display','Название текущего биома'],['Direction HUD','Компас и стороны света'],['Session Stats','Время игровой сессии'],['Cooldown HUD','Визуальные таймеры перезарядки']],
'World Visuals':[['Waypoint Manager','Метки и расстояние до сохранённых точек'],['Block Info','Информация о блоке под прицелом'],['Particle Density','Контроль количества декоративных частиц'],['Weather Visuals','Визуальная настройка погоды'],['Time Presets','Локальные визуальные пресеты времени'],['Sky Color','Цветовая настройка неба в допустимых режимах'],['Damage Numbers','Числа урона в разрешённых режимах'],['Hit Marker','Небольшой визуальный индикатор попадания'],['Pickup Toast','Уведомление о подобранных предметах'],['World Labels','Подписи объектов в обычной видимости']],
'Косметика':[['Color Theme','Цветовая палитра клиента'],['Particles Theme','Цвет и стиль декоративных частиц'],['Screen Effects','Мягкие эффекты интерфейса'],['Animations','Скорость и стиль анимаций'],['Fonts','Выбор шрифта интерфейса'],['Sound Feedback','Звуки интерфейса'],['HUD Scale','Масштаб элементов HUD'],['Rounded UI','Скругление карточек и панелей']],
'Performance':[['FPS Preset','Сбалансированный набор графических настроек'],['Particle Limit','Снижение количества частиц'],['Animation Budget','Отключение необязательных UI-анимаций'],['Entity Render Distance','Подсказка по дистанции прорисовки сущностей'],['Clouds','Настройка облаков'],['Entity Shadows','Настройка теней сущностей'],['Telemetry Panel','Наблюдение за FPS и памятью'],['Network Monitor','Измерение отображаемого ping без обещаний его снижения']]
};
const icons=['▦','⌁','◉','✧','◇','✦','▤','◌','⌖','◷'];let state=JSON.parse(localStorage.getItem('frost_settings')||'{}');let page='home';let role=localStorage.getItem('frost_role')||'Player';let accent=localStorage.getItem('frost_accent')||'#a879ff';document.documentElement.style.setProperty('--accent',accent);
const $=s=>document.querySelector(s);function save(){localStorage.setItem('frost_settings',JSON.stringify(state));toast('Настройки сохранены на устройстве');}function toast(t){let n=document.createElement('div');n.className='notice';n.textContent=t;document.querySelector('#content').prepend(n);setTimeout(()=>n.remove(),2200)}
function moduleCard(name,desc){let id=name.toLowerCase().replace(/[^a-z0-9]+/g,'-');let on=state[id]??(['FPS Counter','Coordinates','Ping Display','Crosshair Editor','Keystrokes','Armor HUD','Potion HUD','Module List'].includes(name));return `<div class="module"><div class="modicon">${icons[name.length%icons.length]}</div><div><b>${name}</b><p>${desc}</p></div><input class="switch" type="checkbox" data-id="${id}" ${on?'checked':''}></div>`}
function hero(){return `<div class="hero"><div><div class="eyebrow">FROST VISUALS / NEW ERA</div><h2>Твой стиль. Твои правила.</h2><p>Единая экосистема визуальных настроек для Minecraft Java. Управляй HUD, интерфейсом, косметикой и профилями в одном месте.</p><button class="primary" data-go="studio">Открыть студию →</button></div></div><div class="stats"><div class="stat"><label>АКТИВНЫЕ МОДУЛИ</label><strong>${Object.values(state).filter(Boolean).length||8}</strong><small class="muted">Твои настройки</small></div><div class="stat"><label>ПОДДЕРЖИВАЕМЫЕ ВЕРСИИ</label><strong>1.21.11 / 1.21.4</strong><small class="muted">Fabric Edition</small></div><div class="stat"><label>ТЕКУЩИЙ ДОСТУП</label><strong>${role.toUpperCase()}</strong><small class="muted">Роль аккаунта</small></div></div><div class="section-head"><h2>Быстрый доступ</h2><span class="muted">Часто используемые функции</span></div><div class="grid">${['FPS Counter','Ping Display','Coordinates','Crosshair Editor','Keystrokes','Armor HUD','Potion HUD','Module List'].map(n=>{let d=Object.values(groups).flat().find(x=>x[0]===n)[1];return moduleCard(n,d)}).join('')}</div>`}
function pageContent(){let titles={home:'Твой визуальный мир',studio:'Студия визуалов',hud:'HUD Studio',performance:'Производительность',profiles:'Профили',account:'Аккаунт и роли',admin:'Панель управления'};$('#pageTitle').textContent=titles[page];if(page==='home')return hero();if(page==='studio'||page==='hud'||page==='performance'){let keys=page==='hud'?['HUD Visuals']:page==='performance'?['Performance']:Object.keys(groups);return keys.map(k=>`<div class="section-head"><h2>${k}</h2><span class="muted">${groups[k].length} модулей</span></div><div class="grid">${groups[k].map(x=>moduleCard(...x)).join('')}</div>`).join('')}
if(page==='profiles')return `<div class="notice">Профили сохраняются локально в этом браузере. Связь с игровым модом и облачная синхронизация включаются после настройки API и авторизации.</div><div class="grid"><div class="card"><div class="eyebrow">PROFILE 01</div><h3>⚡ Performance</h3><p>Минимум необязательных эффектов и анимаций.</p><button class="secondary" data-profile="performance">Применить</button></div><div class="card"><div class="eyebrow">PROFILE 02</div><h3>✦ Balanced</h3><p>Баланс читаемого HUD и визуальных эффектов.</p><button class="secondary" data-profile="balanced">Применить</button></div><div class="card"><div class="eyebrow">PROFILE 03</div><h3>❄ Frost Style</h3><p>Полный фирменный стиль Frost Visuals.</p><button class="secondary" data-profile="frost">Применить</button></div></div><div class="row" style="margin-top:16px"><button class="primary" id="export">Экспорт JSON</button><label class="secondary">Импорт JSON <input type="file" id="import" accept="application/json" hidden></label></div>`;
if(page==='account')return `<div class="grid"><div class="card"><div class="eyebrow">ТВОЙ ПРОФИЛЬ</div><h3>Frost Player</h3><p>Локальный режим предпросмотра. Роль на этом экране не даёт серверных прав.</p><span class="role">${role.toUpperCase()}</span><div class="field"><label>Имя профиля</label><input id="nickname" value="Frost Player"></div><div class="field"><label>Роль для предпросмотра интерфейса</label><select id="role"><option>Player</option><option>Admin</option><option>Owner</option></select></div><button class="primary" id="applyRole">Обновить предпросмотр</button></div><div class="card"><div class="eyebrow">ПРАВА ДОСТУПА</div><h3>Система ролей</h3><p><b>Player</b> — визуалы, HUD, профили.</p><p><b>Admin</b> — модерация пользователей, новости, поддержка.</p><p><b>Owner</b> — управление ролями, релизами, настройками и журналом действий.</p><div class="notice">Важно: настоящие права должны проверяться API. Нельзя доверять роли, записанной только в браузере.</div></div></div>`;
if(page==='admin')return `<div class="notice">Демонстрация интерфейса панели. Перед публикацией подключить серверную авторизацию и проверку ролей через Supabase RLS/API. Не выдавай себе роль Owner через этот экран.</div><div class="grid"><div class="card"><div class="eyebrow">USER MANAGEMENT</div><h3>Пользователи</h3><p>Поиск аккаунтов, статусы, дата регистрации.</p><button class="secondary" disabled>Ожидает подключения API</button></div><div class="card"><div class="eyebrow">ROLE CONTROL</div><h3>Роли и доступы</h3><p>Player · Admin · Owner. Назначение только владельцем.</p><button class="secondary" disabled>Ожидает подключения API</button></div><div class="card"><div class="eyebrow">RELEASE CENTER</div><h3>Версии мода</h3><p>1.21.11 и 1.21.4 · changelog · загрузки.</p><button class="secondary" disabled>Ожидает подключения API</button></div><div class="card"><div class="eyebrow">AUDIT LOG</div><h3>Журнал действий</h3><p>История изменения ролей и настроек.</p><button class="secondary" disabled>Ожидает подключения API</button></div></div>`}
}
function render(){ $('#content').innerHTML=pageContent();$('#sideRole').textContent=role.toUpperCase();$('#sideName').textContent='Frost Player';$('#content').querySelectorAll('.switch').forEach(x=>x.addEventListener('change',()=>{state[x.dataset.id]=x.checked;localStorage.setItem('frost_settings',JSON.stringify(state))}));$('#content').querySelectorAll('[data-go]').forEach(b=>b.onclick=()=>go(b.dataset.go));$('#content').querySelectorAll('[data-profile]').forEach(b=>b.onclick=()=>{let p=b.dataset.profile;state={};let list=p==='performance'?['FPS Counter','Ping Display','Coordinates']:p==='balanced'?['FPS Counter','Ping Display','Coordinates','Armor HUD','Keystrokes','Crosshair Editor']:Object.values(groups).flat().map(x=>x[0]);list.forEach(n=>state[n.toLowerCase().replace(/[^a-z0-9]+/g,'-')]=true);save();render()});let exp=$('#export');if(exp)exp.onclick=()=>{let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(state,null,2)],{type:'application/json'}));a.download='frost-profile.json';a.click()};let imp=$('#import');if(imp)imp.onchange=async()=>{try{state=JSON.parse(await imp.files[0].text());save();render()}catch{toast('Не удалось прочитать профиль')}};let ar=$('#applyRole');if(ar)ar.onclick=()=>{role=$('#role').value;localStorage.setItem('frost_role',role);render()}}
function go(p){page=p;document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===p));render()}document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>go(b.dataset.page));$('#quickSave').onclick=save;$('#themeBtn').onclick=()=>{accent=accent==='#a879ff'?'#5cc8ff':'#a879ff';document.documentElement.style.setProperty('--accent',accent);localStorage.setItem('frost_accent',accent)};$('#search').oninput=e=>{let q=e.target.value.toLowerCase();if(!q){render();return}page='studio';$('#pageTitle').textContent='Результаты поиска';let found=Object.values(groups).flat().filter(x=>(x[0]+x[1]).toLowerCase().includes(q));$('#content').innerHTML=`<div class="grid">${found.map(x=>moduleCard(...x)).join('')}</div>${found.length?'':'<div class="empty">Ничего не найдено</div>'}`;$('#content').querySelectorAll('.switch').forEach(x=>x.onchange=()=>{state[x.dataset.id]=x.checked;localStorage.setItem('frost_settings',JSON.stringify(state))})};render();
